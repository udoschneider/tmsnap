# One record per session, RS-terminated, US-separated. Values are cleaned of
# the separators so the Python side can parse the output without JSON escaping.
ITERM_LAYOUT_SCRIPT = """
on clean(v)
    try
        set s to v as text
    on error
        return ""
    end try
    set AppleScript's text item delimiters to {character id 30, character id 31, linefeed, return}
    set bits to text items of s
    set AppleScript's text item delimiters to " "
    set s to bits as text
    set AppleScript's text item delimiters to ""
    return s
end clean

tell application "iTerm"
    set us to character id 31
    set rs to character id 30
    set out to ""
    set wi to 0
    repeat with w in windows
        set wi to wi + 1
        set wid to id of w
        set wname to my clean(name of w)
        set b to bounds of w
        set bx to item 1 of b
        set bty to item 2 of b
        set br to item 3 of b
        set bb to item 4 of b
        set wf to frontmost of w
        set wh to false
        try
            set wh to is hotkey window of w
        end try
        set curwinid to ""
        try
            set curwinid to my clean(id of current session of w)
        end try
        set ti to 0
        repeat with t in tabs of w
            set ti to ti + 1
            set tname to my clean(title of t)
            set curtabid to ""
            try
                set curtabid to my clean(id of current session of t)
            end try
            set si to 0
            repeat with s in sessions of t
                set si to si + 1
                set sid to my clean(id of s)
                set stty to ""
                try
                    set stty to my clean(tty of s)
                end try
                if stty is not "" then
                    set tact to (curwinid is not "") and (sid is curwinid)
                    set sact to (curtabid is not "") and (sid is curtabid)
                    set sname to my clean(name of s)
                    set sprof to my clean(profile name of s)
                    set spath to ""
                    try
                        tell s to set spath to my clean(variable named "session.path")
                    end try
                    set spid to ""
                    try
                        tell s to set spid to my clean(variable named "session.pid")
                    end try
                    set scol to ""
                    try
                        set scol to my clean(columns of s)
                    end try
                    set srow to ""
                    try
                        set srow to my clean(rows of s)
                    end try
                    set out to out & (wid as text) & us & (wi as text) & us & wname & us & (bx as text) & us & (bty as text) & us & (br as text) & us & (bb as text) & us & (wf as text) & us & (wh as text) & us & (ti as text) & us & tname & us & (tact as text) & us & (si as text) & us & sid & us & stty & us & sname & us & sprof & us & spath & us & spid & us & scol & us & srow & us & (sact as text) & rs
                end if
            end repeat
        end repeat
    end repeat
    return out
end tell
"""


def iterm_running() -> bool:
    if sys.platform != "darwin" or not shutil.which("osascript"):
        return False
    result = osascript('application "iTerm" is running')
    return result.returncode == 0 and result.stdout.strip().lower() == "true"


def as_str(value: str) -> str:
    """Quote a value for an AppleScript string literal."""
    clean = value.replace("\r", " ").replace("\n", " ").replace("\x1e", " ").replace("\x1f", " ")
    return '"' + clean.replace("\\", "\\\\").replace('"', '\\"') + '"'


def _int(value: str, default: int = 0) -> int:
    try:
        return int(float(value))
    except (TypeError, ValueError):
        return default


def iterm_version() -> str:
    result = osascript('tell application "iTerm" to get version')
    return result.stdout.strip() if result.returncode == 0 else "?"


def iterm_layout() -> dict | None:
    """Read windows, tabs and sessions from iTerm2. None when unavailable."""
    if not iterm_running():
        return None
    result = osascript(ITERM_LAYOUT_SCRIPT)
    if result.returncode != 0:
        warn(f"cannot read iTerm tabs: {result.stderr.strip() or 'osascript failed'}")
        return None

    windows: dict[int, dict] = {}
    tabs: dict[tuple[int, int], dict] = {}
    for record in result.stdout.split("\x1e"):
        record = record.strip("\r\n")
        if not record:
            continue
        f = record.split("\x1f")
        if len(f) < 22:
            continue
        wid, wi = _int(f[0]), _int(f[1])
        if not wid:
            continue
        win = windows.get(wid)
        if win is None:
            win = {
                "id": wid,
                "index": wi,
                "name": f[2],
                "bounds": [_int(f[3]), _int(f[4]), _int(f[5]), _int(f[6])],
                "frontmost": f[7] == "true",
                "hotkey": f[8] == "true",
                "tabs": [],
            }
            windows[wid] = win
        key = (wid, _int(f[9]))
        tab = tabs.get(key)
        if tab is None:
            tab = {
                "index": _int(f[9]),
                "title": f[10],
                "active": f[11] == "true",
                "sessions": [],
            }
            tabs[key] = tab
            win["tabs"].append(tab)
        tab["active"] = tab["active"] or f[11] == "true"
        tab["sessions"].append({
            "index": _int(f[12]),
            "id": f[13],
            "tty": f[14],
            "name": f[15],
            "profile": f[16],
            "cwd": f[17],
            "pid": _int(f[18]) or None,
            "columns": _int(f[19]),
            "rows": _int(f[20]),
            "active": f[21] == "true",
        })

    for win in windows.values():
        win["tabs"] = [t for t in win["tabs"] if t["sessions"]]
        for tab in win["tabs"]:
            tab["split"] = infer_split(tab["sessions"])
    return {
        "version": iterm_version(),
        "windows": [w for w in windows.values() if w["tabs"]],
    }


def infer_split(sessions: list[dict]) -> str:
    """Best-effort split direction from the recorded cell sizes.

    AppleScript does not expose the split tree, only each session's size. Equal
    rows with different columns means panes sit side by side (a vertical
    divider); the other way round means they are stacked.
    """
    if len(sessions) < 2:
        return "vertical"
    cols = {s.get("columns", 0) for s in sessions}
    rows = {s.get("rows", 0) for s in sessions}
    if len(rows) == 1 and len(cols) > 1:
        return "vertical"
    if len(cols) == 1 and len(rows) > 1:
        return "horizontal"
    return "vertical"


def tmux_clients() -> dict[str, dict]:
    """Local tmux clients keyed by their TTY. Exact tab <-> session mapping."""
    out = tmux("list-clients", "-F", US.join([
        "#{client_tty}", "#{client_session}", "#{client_control_mode}",
        "#{client_activity}", "#{client_key_table}",
    ]))
    if out.returncode != 0:
        return {}
    clients: dict[str, dict] = {}
    for line in out.stdout.splitlines():
        f = line.split(US)
        if len(f) < 3 or not f[0]:
            continue
        clients[f[0]] = {
            "session": f[1],
            "control": f[2] == "1",
            "activity": _int(f[3]) if len(f) > 3 else 0,
            "key_table": f[4] if len(f) > 4 else "",
        }
    return clients


def tty_processes(tty: str) -> list[dict]:
    name = tty.removeprefix("/dev/")
    if not name:
        return []
    out = run(["ps", "-t", name, "-o", "pid=,ppid=,pgid=,tpgid=,command="])
    rows = []
    for line in out.stdout.splitlines():
        m = re.match(r"\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(.*)$", line)
        if not m:
            continue
        rows.append({
            "pid": int(m.group(1)),
            "ppid": int(m.group(2)),
            "pgid": int(m.group(3)),
            "tpgid": int(m.group(4)),
            "cmd": m.group(5).strip(),
        })
    return rows


def tty_foreground(tty: str) -> tuple[int | None, str | None]:
    """Return (shell pid, foreground command basename) for an iTerm TTY."""
    rows = tty_processes(tty)
    if not rows:
        return None, None
    shell_pid = next((r["pid"] for r in rows if basename(r["cmd"]) in SHELLS), None)
    tpgid = rows[0]["tpgid"]
    leader = next((r for r in rows if r["pid"] == tpgid), None)
    current = basename(leader["cmd"]) if leader else None
    return shell_pid, current


def process_cwd(pid: int) -> str | None:
    if not pid or not shutil.which("lsof"):
        return None
    out = run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"]).stdout
    for line in out.splitlines():
        if line.startswith("n"):
            return line[1:]
    return None


def snapshot_iterm() -> dict | None:
    """Capture iTerm's windows/tabs and bind client tabs to tmux sessions."""
    layout = iterm_layout()
    if not layout or not layout["windows"]:
        return None

    clients = tmux_clients()
    if any(c.get("control") for c in clients.values()):
        warn("iTerm is in tmux control mode; its tabs are driven by tmux, so they were not snapshotted")
        return None
    layout["mode"] = "clients"

    procs, children = proc_table()
    for win in layout["windows"]:
        for tab in win["tabs"]:
            for sess in tab["sessions"]:
                binding = clients.get(sess["tty"])
                if binding:
                    sess["tmux"] = {"session": binding["session"], "control": binding["control"]}
                    sess["agent"] = None
                    sess["command"] = None
                    continue

                shell_pid, current = tty_foreground(sess["tty"])
                pid = shell_pid or sess.get("pid")
                if pid:
                    sess["pid"] = pid
                if not sess.get("cwd") and pid:
                    sess["cwd"] = process_cwd(pid) or ""
                sess["agent"] = None
                sess["command"] = None
                if not pid:
                    continue

                pseudo = {"pane_pid": pid, "current_command": current or "", "cwd": sess["cwd"]}
                agent = agent_for(pseudo, procs, children)
                if agent:
                    sess["agent"] = agent
                else:
                    sess["command"] = foreground_command(pid, procs, children)

    return layout


