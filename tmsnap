def cmd_save(args: argparse.Namespace) -> int:
    snapshot = build_snapshot(args.no_iterm)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(snapshot, indent=2) + "\n"

    write_atomic(STATE_DIR / "latest.json", payload)
    written = ["latest"]
    if args.name:
        slug = slugify(args.name)
        if slug == "latest":
            die("'latest' is reserved")
        write_atomic(snapshot_path(slug), payload)
        written.append(slug)

    panes = sum(len(w["panes"]) for s in snapshot["sessions"] for w in s["windows"])
    agents = agents_in(snapshot)
    tools: dict[str, int] = {}
    for _, _, pane in agents:
        tools[pane["agent"]["tool"]] = tools.get(pane["agent"]["tool"], 0) + 1
    breakdown = ", ".join(f"{n} {t}" for t, n in sorted(tools.items())) or "none"

    print(f"saved {'+'.join(written)} -> {STATE_DIR}")
    print(f"  {len(snapshot['sessions'])} sessions, {panes} panes, "
          f"{len(agents)} agent sessions ({breakdown})")
    iw, itabs, iclients = iterm_stats(snapshot)
    if iw:
        print(f"  {plural(iw, 'iTerm window')}, {plural(itabs, 'tab')} "
              f"({plural(iclients, 'tmux client')})")
    weak = [p for _, _, p in agents if p["agent"]["confidence"] not in ("exact", "exact-unverified")]
    if weak:
        print(f"  {len(weak)} binding(s) are heuristic - run 'tmsnap show' for details")
    stale = [p for _, _, p in agents if p["agent"]["confidence"] == "exact-unverified"]
    if stale:
        print(f"  {len(stale)} binding(s) could not be confirmed by process start time")
    return 0


def cmd_list(_: argparse.Namespace) -> int:
    files = sorted(STATE_DIR.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not files:
        print("no snapshots yet - run 'tmsnap save'")
        return 0
    for path in files:
        try:
            snap = json.loads(path.read_text())
        except (OSError, ValueError):
            print(f"{path.stem:<28} <unreadable>")
            continue
        panes = sum(len(w["panes"]) for s in snap["sessions"] for w in s["windows"])
        agents = len(agents_in(snap))
        created = str(snap.get("created", "?"))[:19].replace("T", " ")
        names = ", ".join(s["name"] for s in snap["sessions"])
        iw, itabs, _ = iterm_stats(snap)
        itail = f"  {itabs} itabs" if iw else ""
        print(f"{path.stem:<28} {created}  {len(snap['sessions'])} sess  "
              f"{panes} panes  {agents} agents{itail}  [{names}]")
    return 0


def print_agent(agent: dict, indent: str = "          ") -> None:
    sid = agent.get("session_id") or "<unidentified>"
    label = agent.get("name") or agent.get("title") or ""
    trust = {"exact": "exact", "exact-unverified": "exact (start time not confirmed)",
             "argv": "from argv", "heuristic": "heuristic",
             "unknown": "unknown"}.get(agent.get("confidence"), "?")
    print(f"{indent}{agent['tool']:<9} {label}")
    print(f"{indent}{sid}")
    print(f"{indent}binding: {trust}"
          f"{'  pid ' + str(agent['pid']) if agent.get('pid') else ''}")
    if agent.get("transcript"):
        print(f"{indent}transcript: {agent['transcript']}")
    if agent.get("ambiguity"):
        print(f"{indent}note: {agent['ambiguity']}")


def cmd_show(args: argparse.Namespace) -> int:
    snap = load_snapshot(args.name)
    print(f"snapshot {args.name!r}  saved {str(snap.get('created','?'))[:19].replace('T',' ')}  "
          f"host {snap.get('host','?')}  {snap.get('tmux_version','?')}")

    agents = agents_in(snap)
    iterm = snap.get("iterm")
    iterm_agents = [
        sess for win in (iterm or {}).get("windows", [])
        for tab in win.get("tabs", []) for sess in tab.get("sessions", [])
        if sess.get("agent")
    ]
    if not agents and not iterm_agents:
        print("  no agent sessions recorded")

    for session in snap["sessions"]:
        windows = session["windows"]
        panes = sum(len(w["panes"]) for w in windows)
        flag = " [attached]" if session.get("attached") else ""
        print(f"\n  session {session['name']}{flag}   ({len(windows)} windows, {panes} panes)")
        for window in windows:
            mark = " *" if window["active"] else "  "
            print(f"  {mark}win {window['index']} \"{window['name']}\""
                  f"{' [zoomed]' if window['zoomed'] else ''}")
            for pane in window["panes"]:
                cursor = ">" if pane["active"] else " "
                print(f"      {cursor} pane {pane['index']}  {pane['cwd']}")
                agent = pane.get("agent")
                if agent:
                    print_agent(agent)
                elif pane.get("command"):
                    print(f"          command (typed, not run): {pane['command']}")
                else:
                    print("          empty shell")

    if iterm:
        iw, itabs, iclients = iterm_stats(snap)
        print(f"\n  iTerm {iterm.get('version', '?')}   ({plural(iw, 'window')}, "
              f"{plural(itabs, 'tab')}, {plural(iclients, 'tmux client')})")
        for window in iterm.get("windows", []):
            front = " [front]" if window.get("frontmost") else ""
            print(f"  window {window['index']}{front}"
                  f"{' [hotkey]' if window.get('hotkey') else ''}")
            for tab in window.get("tabs", []):
                mark = " *" if tab.get("active") else "  "
                print(f"  {mark}tab {tab['index']} \"{tab['title']}\"")
                for sess in tab.get("sessions", []):
                    cursor = ">" if sess.get("active") else " "
                    print(f"      {cursor} session {sess['index']}  "
                          f"{sess.get('cwd') or '<unknown>'}  "
                          f"[{sess.get('profile') or 'default'}]")
                    tmux_session = (sess.get("tmux") or {}).get("session")
                    if tmux_session:
                        print(f"          tmux client -> {tmux_session}  (attach on restore)")
                    elif sess.get("agent"):
                        print_agent(sess["agent"])
                    elif sess.get("command"):
                        print(f"          command (typed, not run): {sess['command']}")
                    else:
                        print("          empty shell")
    return 0


class Runner:
    """Executes tmux commands, or just prints them with --dry-run."""

    def __init__(self, dry: bool):
        self.dry = dry

    def __call__(self, *args: str) -> str:
        if self.dry:
            print("    $ tmux " + " ".join(shlex.quote(a) for a in args))
            return ""
        result = tmux(*args)
        if result.returncode != 0:
            warn(f"tmux {' '.join(args)}: {result.stderr.strip() or 'failed'}")
        return result.stdout

    def query(self, *args: str) -> str:
        if self.dry:
            return ""
        return tmux(*args).stdout.strip()


def has_session(name: str) -> bool:
    return tmux("has-session", "-t", f"={name}").returncode == 0


def wait_for_shell(target: str, shell: str | None, runner: Runner) -> None:
    """Wait until the pane's shell is up *and* has drawn its first prompt.

    `pane_current_command` alone is not enough: it reports the shell the instant
    the process starts, while rc files (prompt themes, zoxide, version managers)
    may still be sourcing. Anything typed then is buffered rather than lost, but
    waiting for real output means the text lands visibly at the prompt.
    """
    if runner.dry:
        return
    deadline = time.time() + 6.0
    wanted = (shell or "").lstrip("-").lower()
    while time.time() < deadline:
        current = tmux("display-message", "-p", "-t", target, "#{pane_current_command}").stdout.strip()
        if current and (not wanted or current.lower() == wanted):
            if tmux("capture-pane", "-p", "-t", target).stdout.strip():
                break
        time.sleep(0.05)
    time.sleep(0.15)


def iterm_plan(snapshot: dict, restored: set[str], only: bool) -> list[dict] | None:
    """Plan the iTerm windows/tabs to recreate, minus hotkey windows."""
    layout = snapshot.get("iterm")
    if not layout:
        return None
    if layout.get("mode") == "control":
        warn("iTerm was in tmux control mode; use 'tmux -CC attach' instead of tab restore")
        return None
    windows = []
    for win in layout.get("windows", []):
        if win.get("hotkey"):
            continue
        tabs = []
        for tab in win.get("tabs", []):
            sessions = tab.get("sessions") or []
            if not sessions:
                continue
            tmux_sessions = {s["tmux"]["session"] for s in sessions if s.get("tmux")}
            if only and (not tmux_sessions or not (tmux_sessions & restored)):
                continue
            tabs.append(tab)
        if tabs:
            windows.append({**win, "tabs": tabs})
    return windows or None


def iterm_existing_tabs() -> dict[str, dict]:
    """tmux session -> existing iTerm tab address, so restore does not duplicate."""
    layout = iterm_layout()
    if not layout:
        return {}
    clients = tmux_clients()
    found: dict[str, dict] = {}
    for win in layout["windows"]:
        for tab in win["tabs"]:
            for sess in tab["sessions"]:
                binding = clients.get(sess["tty"])
                if binding and not binding.get("control") and binding["session"] not in found:
                    found[binding["session"]] = {"window": win["id"], "tab": tab["index"]}
    return found


def iterm_current_window_id() -> int | None:
    result = osascript('tell application "iTerm" to get id of current window')
    if result.returncode != 0:
        return None
    return _int(result.stdout.strip()) or None


def _iterm_ref(result: subprocess.CompletedProcess) -> dict | None:
    if result.returncode != 0:
        warn(f"iTerm: {result.stderr.strip() or 'AppleScript failed'}")
        return None
    f = result.stdout.strip("\r\n").split(US)
    if len(f) < 5:
        warn("iTerm: unexpected reply from AppleScript")
        return None
    return {"window": _int(f[0]), "tab": _int(f[1]), "session": _int(f[2]),
            "tty": f[3], "id": f[4]}


def iterm_make_window(profile: str, name: str) -> dict | None:
    script = f"""
tell application "iTerm"
    set us to character id 31
    try
        set w to create window with profile {as_str(profile)}
    on error
        set w to create window with default profile
    end try
    set s to current session of w
    if {as_str(name)} is not "" then
        try
            tell s to set name to {as_str(name)}
        end try
    end if
    return (id of w as text) & us & "1" & us & "1" & us & (tty of s) & us & (id of s)
end tell
"""
    return _iterm_ref(osascript(script))


# Find the tab/session ordinal of a freshly created session. AppleScript's
# `sessions of tab` is in tree order, which can differ from creation order after
# a split, so counting sessions is not reliable. The session GUID is.
ITERM_FIND_SESSION = """
set targetid to (id of s as text)
set tabOrd to 0
set sessOrd to 0
set ti to 0
repeat with tt in tabs of w
    set ti to ti + 1
    set si to 0
    repeat with ss in sessions of tt
        set si to si + 1
        if (id of ss as text) is targetid then
            set tabOrd to ti
            set sessOrd to si
        end if
    end repeat
end repeat
"""


def iterm_make_tab(wid: int, profile: str, name: str) -> dict | None:
    script = f"""
tell application "iTerm"
    set us to character id 31
    set w to window id {wid}
    try
        tell w
            set t to create tab with profile {as_str(profile)}
        end tell
    on error
        tell w
            set t to create tab with default profile
        end tell
    end try
    set s to current session of t
    if {as_str(name)} is not "" then
        try
            tell s to set name to {as_str(name)}
        end try
    end if
    {ITERM_FIND_SESSION}
    return (id of w as text) & us & (tabOrd as text) & us & (sessOrd as text) & us & (tty of s) & us & (id of s)
end tell
"""
    return _iterm_ref(osascript(script))


def iterm_make_split(wid: int, tab: int, profile: str, direction: str, name: str) -> dict | None:
    how = "vertically" if direction == "vertical" else "horizontally"
    script = f"""
tell application "iTerm"
    set us to character id 31
    set w to window id {wid}
    set t to tab {tab} of w
    set base to session 1 of t
    try
        tell base
            set s to split {how} with profile {as_str(profile)}
        end tell
    on error
        tell base
            set s to split {how} with default profile
        end tell
    end try
    if {as_str(name)} is not "" then
        try
            tell s to set name to {as_str(name)}
        end try
    end if
    {ITERM_FIND_SESSION}
    return (id of w as text) & us & (tabOrd as text) & us & (sessOrd as text) & us & (tty of s) & us & (id of s)
end tell
"""
    return _iterm_ref(osascript(script))


# Locate a session by GUID. The tab/session ordinals move when panes are split,
# so every write addresses the session by its stable iTerm GUID instead.
ITERM_FIND_BY_ID = """
set targetid to {target}
set foundTab to missing value
set foundSess to missing value
set ti to 0
repeat with tt in tabs of w
    set ti to ti + 1
    set si to 0
    repeat with ss in sessions of tt
        set si to si + 1
        if (id of ss as text) is targetid then
            set foundTab to ti
            set foundSess to si
        end if
    end repeat
end repeat
if foundTab is missing value then error "iTerm session is gone"
"""


def _iterm_locate(ref: dict) -> str:
    if ref.get("id"):
        return ITERM_FIND_BY_ID.replace("{target}", as_str(ref["id"]))
    return f"set foundTab to {ref['tab']}\nset foundSess to {ref.get('session') or 1}"


def iterm_write(ref: dict, text: str, newline: bool) -> bool:
    script = f"""
tell application "iTerm"
    set w to window id {ref['window']}
    {_iterm_locate(ref)}
    set t to tab foundTab of w
    set s to session foundSess of t
    tell s to write text {as_str(text)} newline {str(newline).lower()}
end tell
"""
    result = osascript(script)
    if result.returncode != 0:
        warn(f"iTerm: cannot type into tab {ref['tab']}: "
             f"{result.stderr.strip() or 'AppleScript failed'}")
        return False
    return True


def iterm_select(ref: dict) -> None:
    body = [
        'tell application "iTerm"',
        f"    set w to window id {ref['window']}",
        f"    {_iterm_locate(ref)}",
        "    set t to tab foundTab of w",
        "    select w",
        "    select t",
    ]
    if ref.get("id"):
        body.append("    select session foundSess of t")
    body.append("end tell")
    result = osascript("\n".join(body))
    if result.returncode != 0:
        warn(f"iTerm: cannot select tab {ref.get('tab')}: "
             f"{result.stderr.strip() or 'AppleScript failed'}")


def iterm_wait_for_shell(tty: str, timeout: float = 6.0) -> bool:
    """Wait until the new tab's shell owns the foreground process group.

    Returns False when something else is still in the foreground (an rc file, a
    login helper, a password prompt). Typing then would feed that program
    instead of the shell, so the caller must not send anything.
    """
    deadline = time.time() + timeout
    while time.time() < deadline:
        rows = tty_processes(tty)
        if rows:
            tpgid = rows[0]["tpgid"]
            leader = next((r for r in rows if r["pid"] == tpgid), None)
            if leader and basename(leader["cmd"]) in SHELLS:
                time.sleep(0.15)
                return True
        time.sleep(0.05)
    return False


def iterm_send_payload(ref: dict, sess: dict, tab: dict, no_exec: bool) -> None:
    label = f'iTerm tab "{tab.get("title") or "?"}"'
    tmux_session = (sess.get("tmux") or {}).get("session")
    if tmux_session:
        line = f"tmux attach -t {shlex.quote(tmux_session)}"
        if iterm_write(ref, line, not no_exec):
            if no_exec:
                print(f"    {label}  typed (not run): {line}")
            else:
                print(f"    {label}  attaching: {line}")
        return

    cwd = sess.get("cwd") or ""
    cd_sent = False
    if cwd and os.path.normpath(cwd) != str(Path.home()):
        target = pane_cwd(cwd)
        cd_sent = iterm_write(ref, f"cd {shlex.quote(target)}", True)
        if cd_sent:
            time.sleep(0.15)

    agent = sess.get("agent")
    if agent:
        if agent.get("session_id"):
            line = resume_command(agent)
            if iterm_write(ref, line, not no_exec):
                if no_exec:
                    print(f"    {label}  resume (press Enter): {line}")
                else:
                    print(f"    {label}  resuming: {line}")
        else:
            warn(f"{label}: {agent['tool']} is running but no session id was found")
        return

    command = sess.get("command")
    if command:
        if iterm_write(ref, command, False):
            print(f"    {label}  typed (not run): {command}")
    elif cd_sent:
        print(f"    {label}  cd {cwd}")
    else:
        print(f"    {label}  empty shell")


def _iterm_fill_tab(win_id: int, first: dict, tab: dict) -> list[tuple[dict, dict]]:
    sessions = tab.get("sessions", [])
    pairs = [(first, sessions[0])] if sessions else []
    direction = tab.get("split") or "vertical"
    for sess in sessions[1:]:
        ref = iterm_make_split(win_id, first["tab"], sess.get("profile") or "",
                              direction, sess.get("name") or "")
        if ref:
            pairs.append((ref, sess))
    if len(pairs) < len(sessions):
        warn(f'iTerm tab "{tab.get("title")}": only {len(pairs)} of {len(sessions)} panes recreated')
    return pairs


def print_iterm_plan(plan: list[dict], no_exec: bool) -> None:
    print("\n  iTerm tabs (dry run):")
    for win in plan:
        print(f"    window {win['index']} \"{win.get('name') or ''}\"")
        for tab in win["tabs"]:
            if tab.get("_reuse"):
                print(f"      tab \"{tab.get('title')}\" (already attached; reuse)")
                continue
            print(f"      tab \"{tab.get('title')}\"  profile "
                  f"{tab['sessions'][0].get('profile') or 'default'}")
            for sess in tab["sessions"]:
                tmux_session = (sess.get("tmux") or {}).get("session")
                if tmux_session:
                    line = f"tmux attach -t {shlex.quote(tmux_session)}"
                    print(f"        {'type (not run): ' if no_exec else 'attach: '}{line}")
                elif sess.get("agent"):
                    if sess["agent"].get("session_id"):
                        line = resume_command(sess["agent"])
                        print(f"        {'type (not run): ' if no_exec else 'resume: '}{line}")
                    else:
                        print(f"        {sess['agent']['tool']} (no session id)")
                elif sess.get("command"):
                    print(f"        type (not run): {sess['command']}")
                else:
                    print("        empty shell")


def restore_iterm(snapshot: dict, restored: set[str], args: argparse.Namespace) -> bool:
    """Recreate the recorded iTerm windows/tabs. True when tabs were handled."""
    plan = iterm_plan(snapshot, restored, bool(args.only))
    if not plan:
        return False

    running = iterm_running()
    if running:
        existing = iterm_existing_tabs()
        for win in plan:
            for tab in win["tabs"]:
                tmux_sessions = [s["tmux"]["session"] for s in tab["sessions"] if s.get("tmux")]
                tab["_reuse"] = next((existing[s] for s in tmux_sessions if s in existing), None)
    elif not args.dry_run:
        warn("iTerm is not running - cannot restore its tabs")
        return False

    if args.dry_run:
        print_iterm_plan(plan, args.no_exec)
        return True

    current_wid = iterm_current_window_id()
    reuse_current = len(plan) == 1 and current_wid is not None
    addresses: dict[int, dict] = {}
    created = reused = 0

    for win in plan:
        pending = [t for t in win["tabs"] if not t.get("_reuse")]
        reused += len(win["tabs"]) - len(pending)
        for tab in win["tabs"]:
            if tab.get("_reuse"):
                addr = tab["_reuse"]
                addresses[id(tab)] = {"window": addr["window"], "tab": addr["tab"],
                                      "session": None, "id": None}
                print(f'    iTerm tab "{tab.get("title")}" already attached; reusing')

        initial_for: tuple[int, dict] | None = None
        if reuse_current:
            win_id = current_wid
        else:
            if not pending:
                continue
            first = pending[0]
            ref = iterm_make_window(first["sessions"][0].get("profile") or "",
                                    first.get("title") or "")
            if not ref:
                continue
            win_id = ref["window"]
            print(f"\n  iTerm: new window {win_id}")
            initial_for = (id(first), ref)

        for tab in pending:
            initial = initial_for[1] if initial_for and id(tab) == initial_for[0] else None
            if initial is None:
                ref = iterm_make_tab(win_id, tab["sessions"][0].get("profile") or "",
                                     tab.get("title") or "")
                if not ref:
                    continue
            else:
                ref = initial
            created += 1
            pairs = _iterm_fill_tab(win_id, ref, tab)
            active_at = next((i for i, s in enumerate(tab["sessions"]) if s.get("active")), 0)
            active_ref = pairs[active_at][0] if active_at < len(pairs) else ref
            addresses[id(tab)] = active_ref
            for sref, sess in pairs:
                if not iterm_wait_for_shell(sref["tty"]):
                    warn(f'iTerm tab "{tab.get("title")}": the shell is not at a '
                         f"prompt - not typing anything")
                    continue
                iterm_send_payload(sref, sess, tab, args.no_exec)

    if not created and not reused:
        return False

    # Select the recorded active tab of the frontmost window.
    front = next((w for w in plan if w.get("frontmost")), plan[0])
    active = next((t for t in front["tabs"] if t.get("active")), front["tabs"][0])
    if id(active) in addresses:
        iterm_select(addresses[id(active)])
    osascript('tell application "iTerm" to activate')

    print(f"\n  iTerm: {created} tab(s) created, {reused} reused")
    return True


def cmd_restore(args: argparse.Namespace) -> int:
    snap = load_snapshot(args.name)
    runner = Runner(args.dry_run)

    if snap.get("host") and snap["host"] != hostname():
        warn(f"snapshot was taken on {snap['host']!r}, this host is {hostname()!r}")

    sessions = snap["sessions"]
    if args.only:
        wanted = set(args.only)
        sessions = [s for s in sessions if s["name"] in wanted]
        missing = wanted - {s["name"] for s in sessions}
        if missing:
            die(f"not in this snapshot: {', '.join(sorted(missing))}")
    if not sessions:
        die("nothing to restore")

    created = skipped = typed = executed = 0
    verb = "would create" if args.dry_run else "creating"
    print(f"{verb} {len(sessions)} session(s) from {args.name!r}"
          f"{' (dry run)' if args.dry_run else ''}")

    for session in sessions:
        name = session["name"]
        windows = session["windows"]
        if has_session(name):
            if not args.force:
                warn(f"session {name!r} already exists - skipping (use --force to replace)")
                skipped += 1
                continue
            runner("kill-session", "-t", name)
        created += 1

        print(f"\n  {name}")
        first = windows[0]
        start_cwd = pane_cwd(first["panes"][0]["cwd"])
        runner("new-session", "-d", "-s", name, "-c", start_cwd)

        auto = runner.query("display-message", "-p", "-t", f"={name}:", "#{window_index}")
        auto_index = int(auto) if auto.isdigit() else first["index"]
        if auto_index != first["index"]:
            runner("move-window", "-s", f"{name}:{auto_index}", "-t", f"{name}:{first['index']}")
        runner("rename-window", "-t", f"{name}:{first['index']}", first["name"] or f"win{first['index']}")

        for window in windows[1:]:
            runner("new-window", "-d", "-t", f"{name}:{window['index']}",
                   "-n", window["name"] or f"win{window['index']}",
                   "-c", pane_cwd(window["panes"][0]["cwd"]))

        # Extra panes, then replay the recorded layout so geometry comes back exactly.
        for window in windows:
            target_window = f"{name}:{window['index']}"
            for pane in window["panes"][1:]:
                runner("split-window", "-d", "-t", target_window, "-c", pane_cwd(pane["cwd"]))
            if window["layout"] and len(window["panes"]) > 1:
                runner("select-layout", "-t", target_window, window["layout"])
            if window["zoomed"] and window["panes"]:
                active = next((p for p in window["panes"] if p["active"]), window["panes"][0])
                runner("resize-pane", "-Z", "-t", f"{target_window}.{active['index']}")

        for window in windows:
            active = next((p for p in window["panes"] if p["active"]), window["panes"][0])
            runner("select-pane", "-t", f"{name}:{window['index']}.{active['index']}")
        active_window = next((w for w in windows if w["active"]), windows[0])
        runner("select-window", "-t", f"{name}:{active_window['index']}")

        # Now the payload: agent resumes, and inert command lines everywhere else.
        for window in windows:
            for pane in window["panes"]:
                target = f"{name}:{window['index']}.{pane['index']}"
                agent = pane.get("agent")
                if agent and agent.get("session_id"):
                    line = resume_command(agent)
                    wait_for_shell(target, pane.get("shell"), runner)
                    runner("send-keys", "-t", target, "-l", line)
                    if args.no_exec:
                        print(f"    {target}  resume (press Enter): {line}")
                    else:
                        runner("send-keys", "-t", target, "Enter")
                        print(f"    {target}  resuming: {line}")
                        executed += 1
                elif pane.get("command"):
                    wait_for_shell(target, pane.get("shell"), runner)
                    runner("send-keys", "-t", target, "-l", pane["command"])
                    print(f"    {target}  typed (not run): {pane['command']}")
                    typed += 1
                elif agent:
                    warn(f"{target}: {agent['tool']} is running but no session id was found")

    print(f"\n{len(sessions)} session(s) in snapshot: {created} created, {skipped} skipped")
    if typed:
        print(f"{typed} command(s) typed but not executed - press Enter in those panes when ready")
    if executed:
        print(f"{executed} agent session(s) resumed")

    # With iTerm available, --attach recreates the recorded tabs. When that is
    # impossible (no iTerm, no layout, AppleScript refused), fall back to the
    # old single-session behaviour.
    iterm_done = False
    if args.attach and not args.no_iterm:
        iterm_done = restore_iterm(snap, {s["name"] for s in sessions}, args)

    if args.attach and not iterm_done and not args.dry_run and created:
        name = sessions[0]["name"]
        if os.environ.get("TMUX"):
            runner("switch-client", "-t", name)
        else:
            subprocess.run(["tmux", "attach", "-t", name])
    return 0


def pane_cwd(cwd: str) -> str:
    """Fall back to $HOME when a recorded directory is gone (unmounted volume,
    renamed folder, ...) rather than failing the whole restore."""
    if cwd and os.path.isdir(cwd):
        return cwd
    warn(f"directory {cwd!r} no longer exists - using {Path.home()}")
    return str(Path.home())


def resume_command(agent: dict) -> str:
    sid = agent["session_id"]
    if agent["tool"] == "claude":
        argv = agent.get("argv") or []
        if "--resume" in argv or "-r" in argv or "--continue" in argv or "-c" in argv:
            return " ".join(shlex.quote(a) for a in argv)      # keep the user's own flags
        return f"claude --resume {sid}"
    if agent["tool"] == "opencode":
        return f"opencode --session {sid}"
    return f"# unknown agent {agent['tool']}"


def cmd_prune(args: argparse.Namespace) -> int:
    files = sorted(
        (p for p in STATE_DIR.glob("*.json") if p.stem != "latest"),
        key=lambda p: p.stat().st_mtime, reverse=True,
    )
    victims = files[max(args.keep, 0):]
    if not victims:
        print(f"nothing to prune ({len(files)} named snapshot(s), keeping {args.keep})")
        return 0
    for path in victims:
        print(f"  {'removing' if args.yes else 'would remove'} {path.name}")
        if args.yes:
            path.unlink()
    if not args.yes and sys.stdin.isatty():
        if input(f"delete {len(victims)} snapshot(s)? [y/N] ").strip().lower() in ("y", "yes"):
            for path in victims:
                path.unlink()
    elif not args.yes:
        print("re-run with --yes to delete")
    return 0


# --------------------------------------------------------------------------- #
# entry point
# --------------------------------------------------------------------------- #

def main(argv: list[str] | None = None) -> int:
    # Keep warnings and progress in order when output is piped or logged.
    if not sys.stdout.isatty():
        sys.stdout.reconfigure(line_buffering=True)
    parser = argparse.ArgumentParser(
        prog="tmsnap",
        description="Snapshot a terminal workspace: tmux sessions, iTerm2 tabs, "
                    "and the Claude/OpenCode sessions inside them.",
    )
    parser.add_argument("--version", action="version", version=f"tmsnap {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p_save = sub.add_parser("save", help="capture the current terminal workspace")
    p_save.add_argument("name", nargs="?", help="also store under this name")
    p_save.add_argument("--no-iterm", action="store_true",
                        help="do not record iTerm2 windows and tabs")
    p_save.set_defaults(func=cmd_save)

    p_list = sub.add_parser("list", help="list stored snapshots")
    p_list.set_defaults(func=cmd_list)

    p_show = sub.add_parser("show", help="show the contents of a snapshot")
    p_show.add_argument("name", nargs="?", default="latest")
    p_show.set_defaults(func=cmd_show)

    p_restore = sub.add_parser("restore", help="rebuild a snapshot")
    p_restore.add_argument("name", nargs="?", default="latest")
    p_restore.add_argument("--only", action="append", metavar="SESSION",
                           help="restore only this tmux session (repeatable)")
    p_restore.add_argument("--force", action="store_true",
                           help="kill and recreate sessions that already exist")
    p_restore.add_argument("--no-exec", action="store_true",
                           help="type agent resume commands but do not submit them")
    p_restore.add_argument("--dry-run", action="store_true",
                           help="print what would happen, change nothing")
    p_restore.add_argument("--attach", action="store_true",
                           help="recreate iTerm tabs, or attach/switch to the first restored session")
    p_restore.add_argument("--no-iterm", action="store_true",
                           help="do not recreate iTerm tabs when using --attach")
    p_restore.set_defaults(func=cmd_restore)

    p_prune = sub.add_parser("prune", help="delete old named snapshots")
    p_prune.add_argument("--keep", type=int, default=10, help="how many to keep (default 10)")
    p_prune.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    p_prune.set_defaults(func=cmd_prune)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
