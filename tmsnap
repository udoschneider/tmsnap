#!/usr/bin/env python3
"""
tmsnap -- snapshot and restore a terminal workspace: tmux sessions, the iTerm2
tabs that hold their clients, and the Claude Code / OpenCode sessions running
inside their panes.

  tmsnap save [name]            capture the current terminal workspace
  tmsnap list                   list stored snapshots
  tmsnap show [name]            what is in a snapshot (default: latest)
  tmsnap restore [name]         rebuild it (default: latest)
  tmsnap prune --keep N         drop old named snapshots

Design notes
------------
*   Claude Code writes ~/.claude/sessions/<pid>.json for every running session,
    keyed by the PID of the `claude` process. The launcher is a direct child of
    the pane's shell, so walking the process tree gives an exact pane -> session
    UUID mapping with no hooks and no guessing.

*   OpenCode keeps no such per-process file. We fall back to the TUI tab state
    (~/.local/state/opencode/latest/tui/tabs.json, keyed by directory) and, when
    that is ambiguous, to the most recently viewed session in the SQLite DB.
    Those bindings are marked "heuristic" and can be wrong when two OpenCode
    TUIs sit in the same directory.

*   On restore, agent panes get their resume command typed *and* submitted.
    Everything else is typed into the shell but NOT executed, so you get a
    chance to look at it first.

*   iTerm2 tabs are captured through AppleScript and matched to the local tmux
    server with `tmux list-clients`: the client TTY is the same TTY iTerm gave
    the tab. That is an exact tab -> tmux session mapping. Restoring with
    --attach recreates one tab per recorded tmux client, each running
    `tmux attach -t <session>`, plus any plain iTerm tabs.

Nothing in here writes to ~/.claude, the OpenCode database, or iTerm's saved
state.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import socket
import sqlite3
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

VERSION = 1

STATE_DIR = Path(os.environ.get("TMSNAP_DIR", Path.home() / ".local" / "state" / "tmux-snapshot"))
CLAUDE_SESSIONS_DIR = Path.home() / ".claude" / "sessions"
CLAUDE_PROJECTS_DIR = Path.home() / ".claude" / "projects"
OPENCODE_TABS = Path.home() / ".local" / "state" / "opencode" / "latest" / "tui" / "tabs.json"
OPENCODE_DB = Path.home() / ".local" / "share" / "opencode" / "opencode.db"

US = "\x1f"                      # field separator for tmux -F output
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
SHELLS = {"sh", "bash", "zsh", "fish", "dash", "ksh", "tcsh", "csh", "nu", "elvish", "xonsh", "pwsh"}


# --------------------------------------------------------------------------- #
# small helpers
# --------------------------------------------------------------------------- #

def warn(msg: str) -> None:
    print(f"tmsnap: {msg}", file=sys.stderr)


def die(msg: str, code: int = 1) -> "None":
    warn(msg)
    raise SystemExit(code)


def run(cmd: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True)


def osascript(script: str) -> subprocess.CompletedProcess:
    return run(["osascript", "-e", script])


def tmux(*args: str) -> subprocess.CompletedProcess:
    return run(["tmux", *args])


def have_tmux_server() -> bool:
    return tmux("list-sessions").returncode == 0


def now_iso() -> str:
    return datetime.now().astimezone().replace(microsecond=0).isoformat()


def plural(n: int, word: str) -> str:
    return f"{n} {word}{'' if n == 1 else 's'}"


def hostname() -> str:
    return socket.gethostname().split(".")[0]


def slugify(name: str) -> str:
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-")
    if not slug or slug in (".", ".."):
        die(f"invalid snapshot name: {name!r}")
    return slug


# --------------------------------------------------------------------------- #
# process table
# --------------------------------------------------------------------------- #

def proc_table() -> tuple[dict, dict]:
    """Return (procs_by_pid, children_by_ppid) from a single ps call."""
    procs: dict[int, dict] = {}
    children: dict[int, list[int]] = {}
    out = run(["ps", "-axo", "pid=,ppid=,pgid=,tpgid=,command="]).stdout
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(.*)$", line)
        if not m:
            continue
        pid, ppid, pgid, tpgid = (int(m.group(i)) for i in range(1, 5))
        procs[pid] = {"ppid": ppid, "pgid": pgid, "tpgid": tpgid, "cmd": m.group(5).strip()}
        children.setdefault(ppid, []).append(pid)
    return procs, children


def walk(pid: int, children: dict) -> list[tuple[int, int]]:
    """Breadth-first (pid, depth) pairs for pid and all its descendants."""
    seen: set[int] = set()
    out: list[tuple[int, int]] = []
    frontier = [(pid, 0)]
    while frontier:
        cur, depth = frontier.pop(0)
        if cur in seen:
            continue
        seen.add(cur)
        out.append((cur, depth))
        frontier.extend((c, depth + 1) for c in children.get(cur, []))
    return out


def proc_start_epoch(pid: int) -> float | None:
    """Approximate process start time from `ps -o etime`.

    Deliberately not `lstart`: that is locale-dependent, and Claude records
    procStart in UTC while ps prints local time, so the two never compare equal.
    """
    out = run(["ps", "-o", "etime=", "-p", str(pid)]).stdout.strip()
    m = re.match(r"^(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+)$", out)
    if not m:
        return None
    days, hours, minutes, seconds = (int(g or 0) for g in m.groups())
    return time.time() - (days * 86400 + hours * 3600 + minutes * 60 + seconds)


def basename(cmd: str) -> str:
    first = (shlex.split(cmd) or [""])[0]
    return os.path.basename(first).lstrip("-")


# --------------------------------------------------------------------------- #
# agent discovery
# --------------------------------------------------------------------------- #

def find_transcript(session_id: str) -> str | None:
    """Locate the Claude transcript for a session id, wherever its project is."""
    if not CLAUDE_PROJECTS_DIR.is_dir():
        return None
    for hit in CLAUDE_PROJECTS_DIR.glob(f"*/{session_id}.jsonl"):
        return str(hit)
    return None


def claude_from_argv(pane_pid: int, procs: dict, children: dict) -> dict | None:
    """Fallback: read the session UUID straight out of a descendant's argv."""
    for pid, _ in walk(pane_pid, children):
        cmd = procs[pid]["cmd"]
        if "claude" not in cmd:
            continue
        for flag in ("--resume", "-r", "--session-id"):
            parts = shlex.split(cmd)
            if flag in parts:
                value = parts[parts.index(flag) + 1] if parts.index(flag) + 1 < len(parts) else ""
                m = UUID_RE.search(value)
                if m:
                    return {"tool": "claude", "session_id": m.group(0), "confidence": "argv"}
    return None


def find_claude(pane_pid: int, procs: dict, children: dict) -> dict | None:
    """Exact pane -> Claude session mapping via ~/.claude/sessions/<pid>.json."""
    candidates = []
    for pid, depth in walk(pane_pid, children):
        record = CLAUDE_SESSIONS_DIR / f"{pid}.json"
        if not record.exists():
            continue
        try:
            data = json.loads(record.read_text())
        except (OSError, ValueError):
            continue
        if "claude" not in procs[pid]["cmd"]:
            continue
        session_id = data.get("sessionId")
        if not session_id:
            continue
        candidates.append((depth, pid, data, session_id))

    if not candidates:
        return claude_from_argv(pane_pid, procs, children)

    # An interactive session can have background jobs hanging off it (kind
    # "bg"). Prefer interactive, then whatever sits closest to the pane.
    candidates.sort(key=lambda c: (c[2].get("kind") != "interactive", c[0]))
    depth, pid, data, session_id = candidates[0]

    # Guard against a recycled PID: a stale <pid>.json from an unrelated Claude
    # would otherwise be attached to whatever now happens to own that PID.
    started = proc_start_epoch(pid)
    recorded_start = data.get("startedAt")
    verified = False
    if started is not None and isinstance(recorded_start, (int, float)):
        verified = abs(started - recorded_start / 1000.0) <= 300

    return {
        "tool": "claude",
        "session_id": session_id,
        "pid": pid,
        "depth": depth,
        "kind": data.get("kind"),
        "name": data.get("name"),
        "version": data.get("version"),
        "cwd": data.get("cwd"),
        "argv": shlex.split(procs[pid]["cmd"]),
        "transcript": find_transcript(session_id),
        "confidence": "exact" if verified else "exact-unverified",
    }


def db_rows(sql: str, params: list) -> list[dict]:
    """Read-only query against the OpenCode database. Never writes."""
    if not OPENCODE_DB.exists():
        return []
    try:
        con = sqlite3.connect(f"file:{OPENCODE_DB.as_posix()}?mode=ro", uri=True, timeout=2.0)
    except sqlite3.Error:
        return []
    try:
        con.row_factory = sqlite3.Row
        return [dict(r) for r in con.execute(sql, params).fetchall()]
    except sqlite3.Error:
        return []
    finally:
        con.close()


def tabs_cwd_key(tabs: dict, cwd: str) -> str | None:
    by_cwd = tabs.get("cwd") or {}
    if cwd in by_cwd:
        return cwd
    target = os.path.realpath(cwd)
    if target in by_cwd:
        return target
    for key in by_cwd:
        try:
            if os.path.realpath(key) == target:
                return key
        except OSError:
            continue
    return None


def opencode_times(ids: list[str]) -> dict[str, int]:
    if not ids:
        return {}
    marks = ",".join("?" * len(ids))
    times: dict[str, int] = {}
    for table, order in (("session_v2", "coalesce(time_viewed,0)"), ("session", "0")):
        rows = db_rows(
            f"select id, max({order}, time_updated) as t from {table} where id in ({marks})",
            list(ids),
        )
        for row in rows:
            times.setdefault(row["id"], 0)
            times[row["id"]] = max(times[row["id"]], int(row["t"] or 0))
    return times


def opencode_newest_in(cwd: str) -> dict | None:
    for table, order in (
        ("session_v2", "coalesce(time_viewed,0) desc, time_updated desc"),
        ("session", "time_updated desc"),
    ):
        rows = db_rows(
            f"select id, title from {table} "
            f"where directory = ? and time_archived is null order by {order} limit 1",
            [cwd],
        )
        if rows:
            return {"session_id": rows[0]["id"], "title": rows[0]["title"]}
    return None


def find_opencode(cwd: str) -> dict | None:
    """Heuristic pane -> OpenCode session mapping. Two sources, in order:
    the TUI tab state for this directory, then the freshest session in the DB."""
    tabs: dict = {}
    try:
        tabs = json.loads(OPENCODE_TABS.read_text())
    except (OSError, ValueError):
        pass

    key = tabs_cwd_key(tabs, cwd) if tabs else None
    if key:
        entries = [t for t in (tabs["cwd"][key].get("tabs") or []) if t.get("sessionID")]
        if entries:
            note = None
            if len(entries) == 1:
                chosen = entries[0]
            else:
                # Several tabs open in this directory: take the one touched last.
                times = opencode_times([t["sessionID"] for t in entries])
                chosen = max(entries, key=lambda t: times.get(t["sessionID"], 0))
                note = f"{len(entries)} open tabs in this directory, picked the most recent"
            return {
                "tool": "opencode",
                "session_id": chosen["sessionID"],
                "title": chosen.get("title"),
                "confidence": "heuristic",
                "ambiguity": note,
            }

    newest = opencode_newest_in(cwd)
    if newest:
        return {
            "tool": "opencode",
            "session_id": newest["session_id"],
            "title": newest["title"],
            "confidence": "heuristic",
            "ambiguity": "no TUI tab state for this directory; used the freshest session in the DB",
        }
    return None


def foreground_command(pane_pid: int, procs: dict, children: dict) -> str | None:
    """The command line running in the foreground of a shell pane, if any."""
    shell = procs.get(pane_pid)
    if not shell:
        return None
    tpgid = shell["tpgid"]
    if tpgid <= 0 or tpgid == shell["pgid"]:
        return None                                   # shell is sitting at the prompt
    leader = procs.get(tpgid)
    if not leader:
        return None
    head = basename(leader["cmd"])
    if head in SHELLS or head in ("claude", "claude.exe", "opencode"):
        return None
    return leader["cmd"]


def agent_for(pane: dict, procs: dict, children: dict) -> dict | None:
    r"""Route a pane to the right detector. pane[\"current_command\"] is the cheap
    pre-filter: tmux already tells us whether an agent owns the foreground."""
    current = basename(pane["current_command"])
    pane_pid = pane["pane_pid"]

    if current in ("claude", "claude.exe"):
        return find_claude(pane_pid, procs, children)
    if current == "opencode":
        found = find_opencode(pane["cwd"])
        if found:
            return found
        return {"tool": "opencode", "session_id": None, "confidence": "unknown",
                "ambiguity": "opencode is running but no session could be identified"}

    # Fallback: the foreground command lies (wrappers, mise shims, ...), so look
    # for a claude session anywhere under the pane.
    return find_claude(pane_pid, procs, children)


