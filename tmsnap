def collect() -> list[dict]:
    """Read the live tmux server and return a snapshot-ready session list."""
    windows_out = tmux(
        "list-windows", "-a", "-F",
        US.join(["#{session_name}", "#{window_index}", "#{window_name}", "#{window_layout}",
                 "#{window_active}", "#{window_zoomed_flag}"]),
    )
    panes_out = tmux(
        "list-panes", "-a", "-F",
        US.join(["#{session_name}", "#{window_index}", "#{pane_index}", "#{pane_id}",
                 "#{pane_pid}", "#{pane_current_command}", "#{pane_current_path}",
                 "#{pane_title}", "#{pane_active}", "#{pane_tty}"]),
    )
    if windows_out.returncode != 0:
        die("cannot talk to the tmux server")

    procs, children = proc_table()

    windows: dict[tuple[str, int], dict] = {}
    for line in windows_out.stdout.splitlines():
        f = line.split(US)
        if len(f) < 6:
            continue
        key = (f[0], int(f[1]))
        windows[key] = {
            "index": int(f[1]),
            "name": f[2],
            "layout": f[3],
            "active": f[4] == "1",
            "zoomed": f[5] == "1",
            "panes": [],
        }

    for line in panes_out.stdout.splitlines():
        f = line.split(US)
        if len(f) < 10:
            continue
        pane = {
            "index": int(f[2]),
            "pane_id": f[3],
            "pane_pid": int(f[4]),
            "current_command": f[5],
            "cwd": f[6],
            "title": f[7],
            "active": f[8] == "1",
            "tty": f[9],
            "shell": basename(procs.get(int(f[4]), {}).get("cmd", "")) or None,
            "agent": None,
            "command": None,
        }
        pane["agent"] = agent_for(pane, procs, children)
        if not pane["agent"]:
            pane["command"] = foreground_command(pane["pane_pid"], procs, children)
        windows.setdefault((f[0], int(f[1])), {"index": int(f[1]), "name": "", "layout": "",
                                              "active": False, "zoomed": False,
                                              "panes": []})["panes"].append(pane)

    sessions: dict[str, dict] = {}
    for (session_name, _), window in sorted(windows.items(), key=lambda kv: (kv[0][0], kv[0][1])):
        window["panes"].sort(key=lambda p: p["index"])
        sessions.setdefault(session_name, {"name": session_name, "attached": False,
                                          "windows": []})["windows"].append(window)

    for session in sessions.values():
        session["attached"] = any(w["active"] for w in session["windows"])
    return list(sessions.values())


def build_snapshot(no_iterm: bool = False) -> dict:
    if not shutil.which("tmux"):
        die("tmux not found in PATH")
    if not have_tmux_server():
        die("no tmux server running - nothing to snapshot")
    sessions = collect()
    if not sessions:
        die("tmux server has no sessions")
    snapshot = {
        "version": VERSION,
        "created": now_iso(),
        "host": hostname(),
        "tmux_version": tmux("-V").stdout.strip(),
        "sessions": sessions,
    }
    if not no_iterm:
        iterm = snapshot_iterm()
        if iterm:
            snapshot["iterm"] = iterm
    return snapshot


def snapshot_path(name: str) -> Path:
    return STATE_DIR / f"{slugify(name)}.json"


def load_snapshot(name: str) -> dict:
    path = snapshot_path(name)
    if not path.exists():
        available = ", ".join(s.stem for s in sorted(STATE_DIR.glob("*.json"))) or "none"
        die(f"no snapshot named {name!r} (have: {available})")
    try:
        return json.loads(path.read_text())
    except ValueError as exc:
        die(f"snapshot {path} is not valid JSON: {exc}")


def write_atomic(path: Path, text: str) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def agents_in(snapshot: dict) -> list[tuple[str, dict, dict]]:
    out = []
    for session in snapshot["sessions"]:
        for window in session["windows"]:
            for pane in window["panes"]:
                if pane.get("agent"):
                    out.append((session["name"], window, pane))
    return out


def iterm_stats(snapshot: dict) -> tuple[int, int, int]:
    """(windows, tabs, tmux-client tabs) in a snapshot's iTerm layout."""
    layout = snapshot.get("iterm") or {}
    windows = layout.get("windows") or []
    tabs = [t for w in windows for t in w.get("tabs", [])]
    clients = sum(1 for t in tabs for s in t.get("sessions", []) if s.get("tmux"))
    return len(windows), len(tabs), clients


